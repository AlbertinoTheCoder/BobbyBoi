<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BobbyBoi</AssemblyName>
    <Version>2.1.3</Version>
    <Product>BobbyBoi</Product>
    <Authors>AlbertinoTheCoder</Authors>
    <Description>A tiny Minecraft-inspired desktop companion. Small pet. Terrible decisions.</Description>
    <RepositoryUrl>https://github.com/AlbertinoTheCoder/BobbyBoi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon>../../assets/BobbyBoi.ico</ApplicationIcon>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tests/**/*.cs" Exclude="../../tests/**/bin/**;../../tests/**/obj/**" />
    <EmbeddedResource Include="../../assets/chaos.json" LogicalName="BobbyBoi.assets.chaos.json" />
    <EmbeddedResource Include="../../assets/character.json" LogicalName="BobbyBoi.assets.character.json" />
    <EmbeddedResource Include="../../assets/zombie.json" LogicalName="BobbyBoi.assets.zombie.json" />
    <EmbeddedResource Include="../../assets/creeper.json" LogicalName="BobbyBoi.assets.creeper.json" />
  </ItemGroup>
</Project>
